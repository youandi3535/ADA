{
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".venv/Scripts/pythonw -X utf8 scripts/query_kb_hook.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".venv/Scripts/pythonw -X utf8 scripts/collect_qa.py"
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "ada-team-kb": {
      "command": "python",
      "args": [
        "-X",
        "utf8",
        "scripts/kb_mcp_server.py"
      ],
      "env": {}
    }
  }
}
