# ============================================================
# Dockerfile.frontend  -  Streamlit UI 이미지
# Python 3.10-slim 베이스 (작업지시서 §2.3)
# ============================================================
FROM python:3.10-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements/base.txt requirements/frontend.txt /app/requirements/
RUN pip install -r /app/requirements/frontend.txt

COPY . /app

# Streamlit 테마/업로드 한도 (.streamlit/config.toml 은 repo root에 있음)
# COPY . . 로 이미 들어와 있으므로 별도 COPY 불필요

RUN useradd -m -u 1001 ada \
 && chown -R ada:ada /app
USER ada

EXPOSE 8501

HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=40s \
  CMD curl -fs http://localhost:8501/_stcore/health || exit 1

CMD ["streamlit", "run", "frontend/app.py", \
     "--server.port=8501", \
     "--server.address=0.0.0.0", \
     "--server.headless=true"]
