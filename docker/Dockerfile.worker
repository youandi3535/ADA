# syntax=docker/dockerfile:1
# ============================================================
# Dockerfile.worker  -  Celery 워커 이미지 (ML / 오케스트레이션)
# pipeline / training / output / harness 4종이 이 한 이미지 공용
# Python 3.10-slim 베이스 (작업지시서 §2.2)
# ============================================================
FROM python:3.10-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# ML 의존 시스템 패키지 (§3 표 그대로)
#  - build: gcc/g++/build-essential, libpq-dev   (psycopg2/torch C 확장 빌드)
#  - runtime: libpq5, libgomp1(OpenMP), libsndfile1(오디오), libgl1/libglib2.0-0(영상),
#             libmagic1(MIME), poppler-utils(PDF), ffmpeg(A/V)
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential gcc g++ \
        libgomp1 libpq-dev libpq5 \
        libsndfile1 libgl1 libglib2.0-0 \
        libmagic1 poppler-utils \
        ffmpeg \
        curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 1) torch 패밀리(cu121) 를 pytorch 인덱스에서 먼저 설치 — 느린 인덱스를 이 스텝에만 격리.
#    nvidia-* 런타임(수 GB)도 여기서 함께. torch 는 거의 안 바뀌므로 레이어 캐시 재사용 극대화.
COPY requirements/torch-cu121.txt /app/requirements/
RUN --mount=type=cache,target=/root/.cache/pip \
    PIP_NO_CACHE_DIR=0 pip install --timeout=1200 --retries=10 -r /app/requirements/torch-cu121.txt
# 2) 나머지 의존성은 순수 PyPI 로 설치 → pytorch 인덱스 미조회로 빌드 대폭 단축.
#    constraints-worker.txt 로 전 패키지 버전 고정 → pip 백트래킹 방지 + 재현성 확보.
#    transformers/accelerate 등은 이미 설치된 torch 를 그대로 사용(재다운로드 없음).
COPY requirements/base.txt requirements/worker.txt \
     requirements/handlers-tabular.txt \
     requirements/handlers-timeseries.txt \
     requirements/handlers-anomaly.txt \
     requirements/constraints-worker.txt \
     /app/requirements/
RUN --mount=type=cache,target=/root/.cache/pip \
    PIP_NO_CACHE_DIR=0 pip install --timeout=1200 --retries=10 \
        -c /app/requirements/constraints-worker.txt \
        -r /app/requirements/worker.txt

COPY . /app

# HuggingFace 사전학습 가중치 캐시 (compose 볼륨 마운트 지점)
RUN mkdir -p /app/models_cache && chmod 777 /app/models_cache

RUN useradd -m -u 1001 ada \
 && chown -R ada:ada /app
USER ada

# 헬스체크: celery ping
HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=60s \
    CMD celery -A orchestrator.runner inspect ping || exit 1

# 큐별 -Q 와 동시성은 compose의 command 에서 override
CMD ["celery", "-A", "orchestrator.runner", "worker", \
     "--loglevel=info", "--concurrency=2", "-Q", "pipeline"]
