# ============================================================
# Dockerfile.api  -  FastAPI 서버 이미지
# Python 3.10-slim 베이스 (작업지시서 §2.1)
# 빌드 컨텍스트: repo root  (compose의 context: ..)
# ============================================================
FROM python:3.10-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# 런타임 의존: 헬스체크 curl, psycopg2 런타임(libpq5), HTTPS
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl ca-certificates libpq5 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 캐시 최적화: requirements 먼저 복사 → install → 코드 복사
COPY requirements/base.txt requirements/api.txt /app/requirements/
RUN pip install -r /app/requirements/api.txt

COPY . /app

# 비루트 사용자 (R-003) - UID 1001 통일
# HuggingFace 모델 캐시 디렉토리 미리 생성 (ada 소유 → 컨테이너 내에서 모델 다운로드 가능)
RUN useradd -m -u 1001 ada \
 && chown -R ada:ada /app \
 && mkdir -p /home/ada/.cache/huggingface \
 && chown -R ada:ada /home/ada/.cache
USER ada

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=40s \
  CMD curl -fs http://localhost:8000/health || exit 1

# workers=1 고정 — SentenceTransformer 싱글턴 공유 필수
# 멀티워커(≥2)는 프로세스마다 독립 임베딩 모델을 가지므로
# 동일 문자열이라도 워커 간 BLAS 비결정성으로 코사인 유사도가
# ~0.705 까지 떨어져 KB 히트가 불가능해짐 (0.82 임계값 미달).
# 처리량이 필요하면 단일 프로세스 내 async concurrency 로 확장할 것.
CMD ["uvicorn", "api.main:app", \
     "--host", "0.0.0.0", "--port", "8000", \
     "--workers", "1", "--loop", "uvloop"]
