# syntax=docker/dockerfile:1
# ============================================================
# Dockerfile.api  -  FastAPI 서버 이미지
# Python 3.10-slim 베이스 (작업지시서 §2.1)
# 빌드 컨텍스트: repo root  (compose의 context: ..)
# ============================================================
FROM python:3.10-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# 런타임 의존: 헬스체크 curl, psycopg2 런타임(libpq5), HTTPS, 서버 폰트 렌더링(fontconfig)
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl ca-certificates libpq5 fontconfig \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 캐시 최적화: requirements 먼저 복사 → install → 코드 복사
# 1) torch(CPU) 를 pytorch 인덱스에서 먼저 설치 — 느린 인덱스를 이 스텝에만 격리.
#    torch 는 거의 안 바뀌므로 별도 레이어로 두면 캐시 재사용이 극대화된다.
COPY requirements/torch-cpu.txt /app/requirements/
RUN --mount=type=cache,target=/root/.cache/pip \
    PIP_NO_CACHE_DIR=0 pip install --timeout=1200 --retries=10 -r /app/requirements/torch-cpu.txt
# 2) 나머지 의존성은 순수 PyPI 로 설치 → pytorch 인덱스 미조회로 빌드 대폭 단축.
#    constraints-api.txt 로 전 패키지 버전 고정 → pip 백트래킹 방지 + 재현성 확보.
COPY requirements/base.txt requirements/api.txt requirements/constraints-api.txt /app/requirements/
RUN --mount=type=cache,target=/root/.cache/pip \
    PIP_NO_CACHE_DIR=0 pip install --timeout=1200 --retries=10 \
        -c /app/requirements/constraints-api.txt \
        -r /app/requirements/api.txt

COPY . /app

# Pretendard 시스템 폰트 등록 (assets/ 가 COPY 된 이후 실행, root 권한)
RUN mkdir -p /usr/local/share/fonts/pretendard \
    && cp /app/assets/fonts/Pretendard-*.otf /usr/local/share/fonts/pretendard/ \
    && fc-cache -f /usr/local/share/fonts/pretendard/

# 비루트 사용자 (R-003) - UID 1001 통일
# HuggingFace 모델 캐시 디렉토리 미리 생성 (ada 소유 → 컨테이너 내에서 모델 다운로드 가능)
RUN useradd -m -u 1001 ada \
 && chown -R ada:ada /app \
 && mkdir -p /home/ada/.cache/huggingface \
 && chown -R ada:ada /home/ada/.cache \
 && chmod +x /app/docker/api-entrypoint.sh
USER ada

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=40s \
  CMD curl -fs http://localhost:8000/health || exit 1

# 부팅 entrypoint — alembic upgrade head 후 uvicorn 기동.
# workers=1 고정 / 단일 인스턴스 가정은 docker/api-entrypoint.sh 참조.
# (entrypoint 는 ada 소유 + 755, COPY 단계가 USER ada 전에 일어나야 chown 동작 함)
ENTRYPOINT ["/app/docker/api-entrypoint.sh"]
