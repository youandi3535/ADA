# ============================================================
# ADA v2 - MLflow custom image
# Base: ghcr.io/mlflow/mlflow:v2.13.0 (minimal, no DB/S3 drivers)
# Adds: psycopg2-binary (PostgreSQL backend store)
#       boto3            (MinIO/S3 artifact store)
# ============================================================
FROM ghcr.io/mlflow/mlflow:v2.13.0

RUN pip install --no-cache-dir \
      psycopg2-binary==2.9.9 \
      boto3==1.34.84
