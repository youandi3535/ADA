# syntax=docker/dockerfile:1
# ============================================================
# Dockerfile.serving  -  모델 서빙 (CPU 전용, 가벼움)
# Python 3.10-slim 베이스 (작업지시서 §2.4)
# 학습은 worker가, 서빙은 이 이미지가 담당. 평가 단계 외에는 항상 띄우지 않음.
# ============================================================
FROM python:3.10-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# 추론용 최소 의존: OpenMP(LightGBM/XGBoost), libpq5(psycopg), curl(헬스체크)
RUN apt-get update && apt-get install -y --no-install-recommends \
        libgomp1 libpq5 curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 1) torch(CPU) 를 pytorch 인덱스에서 먼저 설치 — 느린 인덱스를 이 스텝에만 격리.
#    (라벨 없는 torch 는 PyPI 기본=CUDA 라 이미지가 비대해짐 → +cpu 로 명시)
COPY requirements/torch-cpu-serving.txt /app/requirements/
RUN --mount=type=cache,target=/root/.cache/pip \
    PIP_NO_CACHE_DIR=0 pip install --timeout=1200 --retries=10 -r /app/requirements/torch-cpu-serving.txt
# 2) 나머지 의존성은 순수 PyPI 로 설치 → pytorch 인덱스 미조회.
#    HJ 2026-06-17 — api/worker 와 동일하게 --timeout/--retries 부여. 기본 pip 는 read 타임아웃 15s·
#    재시도 0 이라 대용량 휠(xgboost ~297MB)을 느린 망에서 받다 ReadTimeoutError 로 빌드 전체 취소됨.
COPY requirements/base.txt requirements/serving.txt /app/requirements/
RUN --mount=type=cache,target=/root/.cache/pip \
    PIP_NO_CACHE_DIR=0 pip install --timeout=1200 --retries=10 -r /app/requirements/serving.txt

COPY . /app

RUN useradd -m -u 1001 ada \
 && chown -R ada:ada /app
USER ada

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=40s \
  CMD curl -fs http://localhost:8080/health || exit 1

CMD ["uvicorn", "serving.main:app", \
     "--host", "0.0.0.0", "--port", "8080", \
     "--workers", "2"]
