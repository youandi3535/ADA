# 기본: 텍스트 파일 자동 정규화
* text=auto eol=lf

# 쉘 스크립트 — 항상 LF (CRLF 로 체크아웃되면 Linux 에서 실행 불가)
*.sh text eol=lf

# Python
*.py text eol=lf

# 설정 파일
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.env text eol=lf

# Dockerfile
Dockerfile* text eol=lf

# SVG / HTML 자산
*.svg text eol=lf
*.html text eol=lf
*.css text eol=lf

# 바이너리 — 줄바꿈 변환 금지
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
