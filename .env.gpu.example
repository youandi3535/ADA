# =============================================================
# ADA v2  -  학원 GPU 서버 (adaserver) 환경변수 템플릿
#           토폴로지 B 기준 (ADR-009 참고)
# -------------------------------------------------------------
# 학원 서버는 VPS (115.68.216.191) 의 일꾼.
# 학원 worker-training 이 VPS Redis 의 training 큐 polling ->
# 학원 GPU 로 학습 -> 결과 모델 가중치 VPS MinIO 업로드.
#
# 사용법:
#   1) cp .env.gpu.example .env
#   2) chmod 600 .env
#   3) CHANGE_ME_must_match_vps 부분은 VPS .env 와 같은 값으로 채움
#      (JWT 토큰 호환 + DB/MinIO 접속을 위해 필수)
#   4) docker compose -f docker-compose.yml -f docker-compose.gpu.yml \
#        --profile ml up -d --no-deps worker-training
#
# 시크릿은 절대 git 에 커밋하지 말 것 (.gitignore 에 포함)
# =============================================================

# ===== VPS 마스터 주소 =====
VPS_HOST=115.68.216.191

# ===== Redis (VPS 큐 polling) =====
REDIS_URL=redis://${VPS_HOST}:6379/0

# ===== PostgreSQL (VPS 마스터) =====
POSTGRES_USER=autoai
POSTGRES_PASSWORD=CHANGE_ME_must_match_vps
POSTGRES_DB=autoai
DATABASE_URL=postgresql://autoai:${POSTGRES_PASSWORD}@${VPS_HOST}:5432/autoai

# ===== MinIO (VPS 아티팩트 저장소) =====
MINIO_ENDPOINT=${VPS_HOST}:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=CHANGE_ME_must_match_vps
MINIO_BUCKET=autoai-artifacts

# ===== MLflow (VPS 실험 추적) =====
MLFLOW_TRACKING_URI=http://${VPS_HOST}:5000
MLFLOW_S3_ENDPOINT_URL=http://${VPS_HOST}:9000
AWS_ACCESS_KEY_ID=${MINIO_ACCESS_KEY}
AWS_SECRET_ACCESS_KEY=${MINIO_SECRET_KEY}

# ===== Ollama (학원 로컬 — 토폴로지 B 핵심) =====
# 학원 호스트의 native Ollama 를 컨테이너에서 가리킴.
# docker-compose.gpu.yml 에 extra_hosts: host.docker.internal:host-gateway 필요.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_CODER_MODEL=qwen2.5-coder:7b
OLLAMA_HOOK_ENABLE=1

# ===== LLM API (VPS 와 동일 키) =====
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ada-pipeline

# ===== JWT / 시크릿 (VPS 와 반드시 동일) =====
# VPS 가 발급한 JWT 를 학원 워커가 검증해야 하므로 같은 값.
SECRET_KEY=CHANGE_ME_must_match_vps
JWT_SECRET=CHANGE_ME_must_match_vps
JWT_ALGO=HS256
JWT_EXPIRE_MIN=60

# ===== GPU 설정 (학원 GTX 1060 3GB) =====
CUDA_VISIBLE_DEVICES=0
NVIDIA_VISIBLE_DEVICES=0

# ===== 애플리케이션 =====
LOG_LEVEL=INFO
ENVIRONMENT=development
TZ=Asia/Seoul
PIPELINE_TIMEOUT_MIN=30
MAX_UPLOAD_SIZE_MB=100

# ===== LLM 사용량 가드 =====
MAX_DAILY_LLM_USD=20

# ===== KB 수집 (이미 VPS 가리킴) =====
KB_SERVER_URL=http://${VPS_HOST}/api
KB_COLLECT_SECRET=CHANGE_ME_must_match_vps

# ===== Worker 전용 (학원 worker-training) =====
WORKER_PROFILE=training
WORKER_QUEUE=training
WORKER_POLL_INTERVAL=3

# ===== Vault (학원에선 미사용 — VPS 만 띄움) =====
# VAULT_DEV_TOKEN=
# VAULT_ADDR=
