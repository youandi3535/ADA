# =============================================================

# ADA v2  -  Environment Variables Template  (작업지시서 §6 / 25개 키)

# -------------------------------------------------------------

# 사용법:

#   1) cp .env.example .env

#   2) chmod 600 .env

#   3) 각 값(특히 *_PASSWORD, *_KEY, *_SECRET, *_TOKEN)을 실값으로 채움

#       openssl rand -base64 24   ->  PASSWORD 류

#       openssl rand -hex 32      ->  SECRET / JWT_SECRET

#       openssl rand -hex 16      ->  VAULT_DEV_TOKEN

#   4) .env 는 절대 git 에 커밋하지 말 것 (.gitignore 에 이미 포함)

#

# 운영(VPS)/CI 비밀값은 GitHub Secrets 에도 동일 키로 등록.

# =============================================================



# ----- LLM API -----

ANTHROPIC_API_KEY=sk-ant-CHANGE_ME

LANGSMITH_API_KEY=

LANGSMITH_PROJECT=ada-pipeline



# ----- PostgreSQL -----

POSTGRES_USER=autoai

POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_base64_24

POSTGRES_DB=autoai

DATABASE_URL=postgresql://autoai:${POSTGRES_PASSWORD}@postgres:5432/autoai



# ----- Redis -----

REDIS_URL=redis://redis:6379/0



# ----- MinIO (S3 호환) -----

MINIO_ENDPOINT=minio:9000

MINIO_ACCESS_KEY=minioadmin

MINIO_SECRET_KEY=CHANGE_ME_openssl_rand_base64_24

MINIO_BUCKET=autoai-artifacts



# ----- MLflow -----

MLFLOW_TRACKING_URI=http://mlflow:5000

MLFLOW_S3_ENDPOINT_URL=http://minio:9000

AWS_ACCESS_KEY_ID=${MINIO_ACCESS_KEY}

AWS_SECRET_ACCESS_KEY=${MINIO_SECRET_KEY}



# ----- Vault (Day17) -----

VAULT_DEV_TOKEN=CHANGE_ME_openssl_rand_hex_16

VAULT_ADDR=http://vault:8200



# ----- 보안 (Day17) -----

SECRET_KEY=CHANGE_ME_openssl_rand_hex_32

JWT_SECRET=CHANGE_ME_openssl_rand_hex_32

JWT_ALGO=HS256

JWT_EXPIRE_MIN=60



# ----- 애플리케이션 -----

LOG_LEVEL=INFO

MAX_UPLOAD_SIZE_MB=100

PIPELINE_TIMEOUT_MIN=60

ENVIRONMENT=development

TZ=Asia/Seoul



# ----- GPU (worker-training 에만 영향, GPU override 사용 시) -----

CUDA_VISIBLE_DEVICES=0

NVIDIA_VISIBLE_DEVICES=0



# ----- LLM 사용량 가드 (Day17) -----

MAX_DAILY_LLM_USD=20



# ----- 백업 (Pull 방식 — 로컬 리눅스 서버에서 관리) -----

# 백업 스크립트는 VPS가 아닌 로컬 리눅스 서버에서 실행됨.

# 설정값은 로컬 리눅스의 /etc/ada-backup.conf 에 입력.

# (scripts/backup.conf.example 참고)





# ----- 팀 KB 수집 (Stop 훅 자동 저장) -----

# KB_SERVER_URL 미설정 시 scripts/collect_qa.py 가 아래 VPS 주소를 기본값으로 사용.

# VPS 서버에서 작업 중이거나 localhost 에 직접 docker 가 돌고 있으면 아래 주석 해제.

# KB_SERVER_URL=http://localhost:8000

KB_SERVER_URL=http://YOUR_KB_SERVER_HOST/api

KB_COLLECT_SECRET=CHANGE_ME_openssl_rand_hex_32



# ----- KPI 측정 (Day 10) -----

# /admin/observability/kpi 응답 캐시 TTL (초). 0 이면 캐시 비활성.

KPI_CACHE_TTL_SECONDS=60

# 기본 측정 윈도우 (시간). UI / CLI 기본값.

KPI_DEFAULT_WINDOW_HOURS=24

# 외부 Prometheus 서버 URL (옵션). 미설정 시 in-process histogram 사용.

# 예: http://prometheus:9090

# KPI_PROMETHEUS_URL=


# ── PPT 시각 품질 향상 — Stock 이미지 API (HJ 2026-06-08) ──
# 무료 발급:
#   Unsplash : https://unsplash.com/developers (50 req/h)
#   Pexels   : https://www.pexels.com/api (200 req/h)
#   Pixabay  : https://pixabay.com/api/docs (무제한)
# 키 없어도 PPT 생성 작동 — 표지가 기존 그라데이션 디자인으로 폴백.
# 키 등록 시 표지·섹션 디바이더에 자동 stock 사진 적용 (Unsplash → Pexels → Pixabay fallback).
# UNSPLASH_ACCESS_KEY=
# PEXELS_API_KEY=
# PIXABAY_API_KEY=
