# =============================================================
# ADA v2  -  Environment Variables Template  (작업지시서 §6 / 25개 키)
# -------------------------------------------------------------
# 사용법:
#   1) cp .env.example .env
#   2) chmod 600 .env
#   3) 각 값(특히 *_PASSWORD, *_KEY, *_SECRET, *_TOKEN)을 실값으로 채움
#       openssl rand -base64 24   ->  PASSWORD 류
#       openssl rand -hex 32      ->  SECRET / JWT_SECRET
#       openssl rand -hex 16      ->  VAULT_DEV_TOKEN
#   4) .env 는 절대 git 에 커밋하지 말 것 (.gitignore 에 이미 포함)
#
# 운영(VPS)/CI 비밀값은 GitHub Secrets 에도 동일 키로 등록.
# =============================================================

# ----- LLM API -----
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ada-pipeline

# ----- PostgreSQL -----
POSTGRES_USER=autoai
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_base64_24
POSTGRES_DB=autoai
DATABASE_URL=postgresql://autoai:${POSTGRES_PASSWORD}@postgres:5432/autoai

# ----- Redis -----
REDIS_URL=redis://redis:6379/0

# ----- MinIO (S3 호환) -----
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=CHANGE_ME_openssl_rand_base64_24
MINIO_BUCKET=autoai-artifacts

# ----- MLflow -----
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_S3_ENDPOINT_URL=http://minio:9000
AWS_ACCESS_KEY_ID=${MINIO_ACCESS_KEY}
AWS_SECRET_ACCESS_KEY=${MINIO_SECRET_KEY}

# ----- Vault (Day17) -----
VAULT_DEV_TOKEN=CHANGE_ME_openssl_rand_hex_16
VAULT_ADDR=http://vault:8200

# ----- 보안 (Day17) -----
SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_ALGO=HS256
JWT_EXPIRE_MIN=60

# ----- 애플리케이션 -----
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=100
PIPELINE_TIMEOUT_MIN=30
ENVIRONMENT=development
TZ=Asia/Seoul

# ----- GPU (worker-training 에만 영향, GPU override 사용 시) -----
CUDA_VISIBLE_DEVICES=0
NVIDIA_VISIBLE_DEVICES=0

# ----- LLM 사용량 가드 (Day17) -----
MAX_DAILY_LLM_USD=20

# ----- 백업 (Pull 방식 — 로컬 리눅스 서버에서 관리) -----
# 백업 스크립트는 VPS가 아닌 로컬 리눅스 서버에서 실행됨.
# 설정값은 로컬 리눅스의 /etc/ada-backup.conf 에 입력.
# (scripts/backup.conf.example 참고)
